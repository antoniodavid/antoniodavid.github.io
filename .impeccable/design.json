      "html": "<section class=\"ds-terminal\"><header class=\"ds-terminal-bar\"><span class=\"ds-terminal-title\">terminal</span></header><pre class=\"ds-terminal-body\"><code>$ status\nready</code></pre></section>",
      "css": ".ds-terminal{display:flex;flex-direction:column;overflow:hidden;border:var(--bw) solid var(--line);border-radius:var(--radius-md);background:var(--terminal);color:var(--terminal-text)}.ds-terminal-bar{display:flex;align-items:center;padding:.55rem .7rem;border-bottom:1px solid var(--terminal-line)}.ds-terminal-title{color:var(--terminal-muted);font-family:var(--font-mono);font-size:.55rem}.ds-terminal-body{min-height:9rem;margin:0;padding:1rem;color:var(--terminal-text);font-family:var(--font-mono);font-size:.7rem;line-height:1.8;white-space:pre-wrap}.ds-terminal-body code{font-family:inherit}"
