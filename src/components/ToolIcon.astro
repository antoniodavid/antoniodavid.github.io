---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "ODF Agent Team" && (
    <Fragment>
      <path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"></path>
      <path d="M9 12l2 2 4-4"></path>
    </Fragment>
  )}
  {name === "OpenCode" && (
    <Fragment>
      <rect x="3" y="4" width="18" height="16" rx="3"></rect>
      <path d="M7 9l3 3-3 3"></path>
      <path d="M13 15h4"></path>
    </Fragment>
  )}
  {name === "pi" && (
    <Fragment>
      <path d="M4 8h16"></path>
      <path d="M8 8v9"></path>
      <path d="M16 8v9"></path>
    </Fragment>
  )}
  {name === "Codex" && (
    <Fragment>
      <path d="M8 5l-4 7 4 7"></path>
      <path d="M16 5l4 7-4 7"></path>
      <path d="M13 4l-2 16"></path>
    </Fragment>
  )}
  {name === "Herdr" && (
    <Fragment>
      <rect x="3" y="4" width="18" height="16" rx="2"></rect>
      <path d="M3 9h18"></path>
      <path d="M9 9v11"></path>
      <path d="M13 13h4"></path>
    </Fragment>
  )}
  {name === "Neovim" && (
    <Fragment>
      <path d="M5 4l7 16 7-16"></path>
      <path d="M5 4h4l3 7"></path>
      <path d="M15 4h4l-3 7"></path>
    </Fragment>
  )}
  {name === "Lazygit" && (
    <Fragment>
      <circle cx="6" cy="6" r="2"></circle>
      <circle cx="18" cy="6" r="2"></circle>
      <circle cx="12" cy="18" r="2"></circle>
      <path d="M6 8v3a3 3 0 0 0 3 3h3"></path>
      <path d="M18 8v3a3 3 0 0 1-3 3h-3"></path>
    </Fragment>
  )}
  {name === "Doodba" && (
    <Fragment>
      <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"></path>
      <path d="M4 7.5l8 4.5 8-4.5"></path>
      <path d="M12 12v9"></path>
    </Fragment>
  )}
  {name === "Omarchy" && (
    <Fragment>
      <path d="M4 20V9a8 8 0 0 1 16 0v11"></path>
      <path d="M8 20v-9a4 4 0 0 1 8 0v9"></path>
    </Fragment>
  )}
  {name !== "ODF Agent Team" &&
    name !== "OpenCode" &&
    name !== "pi" &&
    name !== "Codex" &&
    name !== "Herdr" &&
    name !== "Neovim" &&
    name !== "Lazygit" &&
    name !== "Doodba" &&
    name !== "Omarchy" && <circle cx="12" cy="12" r="8"></circle>}
</svg>
