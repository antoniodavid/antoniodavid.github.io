---
import "@fontsource-variable/sora";
import "@fontsource-variable/dm-sans";
import "@fontsource-variable/jetbrains-mono";

const title = "Antonio David | Odoo, AI, and OWL engineer";
const description =
  "Antonio David builds AI-assisted Odoo delivery tools, Odoo modules and migrations, OWL frontends, and reviewed OCA contributions. Public work and verified counts.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff8e8" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <div class="header-inner container">
        <a class="brand" href="#top" aria-label="AD Antonio David, home">
          <span class="brand-mark">AD</span>{" "}
          <span class="brand-text">Antonio David</span>
        </a>
        <nav aria-label="Primary navigation">
          <ul class="nav-list">
            <li><a href="#focus">Focus</a></li>
            <li><a href="#proof">Proof</a></li>
            <li><a href="#work">Work</a></li>
            <li><a href="#oca">OCA</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
        </nav>
        <div class="header-actions">
          <a class="header-link" href="https://github.com/antoniodavid">GitHub <span aria-hidden="true">↗</span></a>
          <a class="header-cta" href="mailto:antoniodavid8@gmail.com">Let's talk</a>
        </div>
      </div>
      <div class="header-stats">
        <div class="header-stats-inner container">
          <span class="header-stat"><strong>290</strong> merged PRs</span>
          <span class="header-stat"><strong>10</strong> OCA merges</span>
          <span class="header-stat"><strong>78</strong> reviews</span>
          <span class="header-stat"><strong>1,477</strong> tests</span>
          <span class="header-stat"><strong>8→19</strong> Odoo</span>
          <span class="header-stat"><strong>520×</strong> faster</span>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <p class="footer-name">Antonio David</p>
          <p class="footer-role">Odoo · AI · OWL · OCA</p>
        </div>
        <nav class="footer-nav" aria-label="Footer navigation">
          <a href="#focus">Focus</a>
          <a href="#proof">Proof</a>
          <a href="#work">Work</a>
          <a href="#oca">OCA</a>
          <a href="#contact">Contact</a>
        </nav>
        <div class="footer-meta">
          <p>Static Astro page. No trackers. No remote assets.</p>
          <p>Last updated October 2026.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
