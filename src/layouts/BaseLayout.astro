---
import "@fontsource-variable/sora";
import "@fontsource-variable/dm-sans";
import "@fontsource-variable/jetbrains-mono";
import soraFont from "@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url";
import dmSansFont from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";
import monoFont from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import {
  themeBackgrounds,
  themeCss,
  themeLabels,
  themes,
} from "../data/themes";

const { locale = "en", title, description, t, path } = Astro.props;
const currentPath = path ?? (locale === "es" ? "/es/" : "/");
const canonical = `https://antoniodavid.github.io${currentPath}`;
const enPath =
  locale === "es" ? currentPath.replace(/^\/es/, "") || "/" : currentPath;
const esPath =
  locale === "es" ? currentPath : currentPath === "/" ? "/es/" : `/es${currentPath}`;
const themeHref = locale === "es" ? "/es/theme/" : "/theme/";
---

<!doctype html>
<html lang={locale} data-theme="paper" data-theme-choice="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeBackgrounds.paper} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={`https://antoniodavid.github.io${enPath}`} />
    <link rel="alternate" hreflang="es" href={`https://antoniodavid.github.io${esPath}`} />
    <title>{title}</title>
    <style id="theme-tokens" is:inline set:html={themeCss}></style>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const legacy = { light: "paper", dark: "sumi" };
        const valid = ["paper", "sumi", "tokyo", "gruvbox", "system"];
        let choice = "system";
        try {
          const saved = localStorage.getItem("theme");
          if (saved) choice = legacy[saved] || saved;
        } catch (_) {
          /* Storage can be unavailable; the system preference still works. */
        }
        if (!valid.includes(choice)) choice = "system";
        const dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.themeChoice = choice;
        root.dataset.theme = choice === "system" ? (dark ? "sumi" : "paper") : choice;
      })();
    </script>
    <link rel="preload" href={soraFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={dmSansFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="stylesheet" href="/styles.css" />
    <noscript><style>.theme-toggle { display: none; }</style></noscript>
  </head>
  <body data-theme-applied={t.themeLab?.applied ?? ""}>
    <a class="skip-link" href="#main-content">{t.skip}</a>

    <header class="site-header">
      <div class="header-inner container">
        <div class="brand-wrap">
          <a class="brand" href={locale === "es" ? "/es/" : "/"} aria-label={t.header.brandLabel}>
            <span class="brand-mark">AD</span>{" "}
            <span class="brand-text">Antonio David</span>
          </a>
          <span class="brand-tagline" aria-hidden="true">{t.header.tagline}</span>
        </div>

        <nav class="site-nav" aria-label={t.header.navLabel}>
          {t.header.nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>

        <div class="header-actions">
          <a class="availability" href="#contact">
            <span class="status-dot" aria-hidden="true"></span>
            {t.header.availability}
          </a>
          <div class="language-switcher" role="group" aria-label={t.header.languageLabel}>
            <a
              href={enPath}
              hreflang="en"
              lang="en"
              class:list={["lang-link", { active: locale === "en" }]}
              aria-current={locale === "en" ? "page" : undefined}
            >EN</a>
            <a
              href={esPath}
              hreflang="es"
              lang="es"
              class:list={["lang-link", { active: locale === "es" }]}
              aria-current={locale === "es" ? "page" : undefined}
            >ES</a>
          </div>
          <button
            class="theme-toggle"
            type="button"
            popovertarget="theme-menu"
            aria-label={t.header.themeMenu}
            aria-haspopup="true"
            data-theme-label={t.header.themeMenu}
            title={t.header.themeMenu}
          >
            <span class="theme-icon" aria-hidden="true">◐</span>
          </button>
          <div id="theme-menu" class="theme-menu" popover="auto">
            <p class="theme-menu-title">{t.header.themeMenu}</p>
            {themes.map((theme) => (
              <label class="theme-option">
                <input type="radio" name="theme-menu" value={theme.id} data-theme-choice />
                <span
                  class="theme-swatch"
                  style={`background:${theme.colors.bg};border-color:${theme.colors.ink}`}
                  aria-hidden="true"
                ></span>
                <span>{theme.label}</span>
              </label>
            ))}
            <label class="theme-option">
              <input type="radio" name="theme-menu" value="system" data-theme-choice />
              <span class="theme-swatch theme-swatch-system" aria-hidden="true">◐</span>
              <span>{t.header.themeSystem}</span>
            </label>
            <a class="theme-menu-link" href={themeHref}>
              {t.header.themeLab} <span aria-hidden="true">→</span>
            </a>
          </div>
          <a class="header-cta" href="mailto:antoniodavid8@gmail.com">
            {t.header.cta} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>{t.footer.brand}</p>
        <nav aria-label={t.footer.navLabel}>
          {t.footer.nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
          <a href={themeHref}>{t.footer.themes}</a>
        </nav>
        <p>{t.footer.meta}</p>
      </div>
      <div class="statusline" aria-hidden="true">
        <span class="status-mode">NORMAL</span>
        <span class="status-file">~/antoniodavid.github.io</span>
        <span class="status-branch">main</span>
        <span class="status-fill"></span>
        <span class="status-theme">theme <b data-status-theme>paper</b></span>
        <span class="status-encoding">utf-8</span>
        <span class="status-pct">100%</span>
      </div>
    </footer>

    <script is:inline define:vars={{ THEME_BG: themeBackgrounds, THEME_NAMES: themeLabels }}>
      (() => {
        const root = document.documentElement;
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const meta = document.querySelector('meta[name="theme-color"]');
        const status = document.querySelector("[data-theme-status]");
        const statusTheme = document.querySelector("[data-status-theme]");
        const template = document.body.dataset.themeApplied || "";
        const toggle = document.querySelector(".theme-toggle");
        const resolve = (choice) =>
          choice === "system" ? (media.matches ? "sumi" : "paper") : choice;

        const sync = (choice) => {
          const theme = resolve(choice);
          root.dataset.theme = theme;
          root.dataset.themeChoice = choice;
          root.style.colorScheme = theme === "paper" ? "light" : "dark";
          if (meta) meta.setAttribute("content", THEME_BG[theme] || "#fffdf7");
          if (statusTheme) statusTheme.textContent = theme;
          document.querySelectorAll("input[data-theme-choice]").forEach((input) => {
            input.checked = input.value === choice;
          });
          if (toggle) {
            toggle.setAttribute(
              "aria-label",
              `${toggle.dataset.themeLabel}: ${THEME_NAMES[theme]}`,
            );
          }
          if (status && template) {
            status.textContent = template.replace("{name}", THEME_NAMES[theme]);
          }
        };

        const apply = (choice, persist) => {
          sync(choice);
          if (!persist) return;
          try {
            localStorage.setItem("theme", choice);
          } catch (_) {
            /* The theme still applies for this page view. */
          }
        };

        document.addEventListener("change", (event) => {
          const input = event.target.closest("input[data-theme-choice]");
          if (!input || !input.checked) return;
          apply(input.value, true);
        });

        media.addEventListener("change", () => {
          if ((root.dataset.themeChoice || "system") === "system") sync("system");
        });

        sync(root.dataset.themeChoice || "system");
      })();
    </script>

    <script is:inline>
      (() => {
        const terminal = document.querySelector("[data-terminal]");
        if (!terminal) return;
        const lines = Array.from(terminal.querySelectorAll("[data-terminal-line]"));
        if (!lines.length) return;

        const nodes = lines.map((line) => line.querySelector(".terminal-text"));
        const texts = nodes.map((node) => node?.textContent ?? "");
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

        const restore = () => {
          terminal.classList.remove("is-typing");
          lines.forEach((line, index) => {
            line.classList.remove("is-typing");
            if (nodes[index]) nodes[index].textContent = texts[index];
          });
        };

        if (reduce.matches || !("IntersectionObserver" in window)) return;

        const run = () => {
          terminal.classList.add("is-typing");
          nodes.forEach((node) => {
            if (node) node.textContent = "";
          });

          let lineIndex = 0;
          let charIndex = 0;

          const tick = () => {
            const line = lines[lineIndex];
            const text = texts[lineIndex];
            line.classList.add("is-typing");
            charIndex += 1;
            if (nodes[lineIndex]) nodes[lineIndex].textContent = text.slice(0, charIndex);

            if (charIndex < text.length) {
              window.setTimeout(tick, 9);
              return;
            }

            line.classList.remove("is-typing");
            lineIndex += 1;
            charIndex = 0;

            if (lineIndex < lines.length) {
              window.setTimeout(tick, 90);
            } else {
              terminal.classList.remove("is-typing");
            }
          };

          tick();
        };

        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            observer.disconnect();
            run();
          },
          { threshold: 0.35 },
        );

        observer.observe(terminal);

        reduce.addEventListener("change", (event) => {
          if (!event.matches) return;
          observer.disconnect();
          restore();
        });
      })();
    </script>
  </body>
</html>
