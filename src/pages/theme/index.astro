---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ThemeLab from "../../components/ThemeLab.astro";
import { content } from "../../data/content";

const t = content.en;
---

<BaseLayout
  locale="en"
  path="/theme/"
  title={t.themeLab.pageTitle}
  description={t.themeLab.description}
  t={t}
>
  <ThemeLab t={t} locale="en" />
</BaseLayout>
