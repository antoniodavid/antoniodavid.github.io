---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main id="main-content">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-decor" aria-hidden="true">
        <span class="blob blob-blue"></span>
        <span class="blob blob-coral"></span>
        <span class="blob blob-yellow"></span>
      </div>

      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">
            <span>AI delivery</span>
            <span>Odoo</span>
            <span>OWL</span>
            <span>OCA</span>
          </p>
          <h1 id="hero-title">Odoo, AI, and OWL tools that <mark>remove the busywork</mark>.</h1>
          <p class="hero-lede">Python and Odoo fullstack developer. I build AI-assisted delivery tools, ship Odoo modules and migrations, experiment with OWL, and review work in the Odoo Community Association.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#proof">See the proof</a>
            <a class="button button-secondary" href="#oca">Explore the OCA wins</a>
          </div>
          <p class="hero-meta">Public GitHub <span aria-hidden="true">·</span> Verified 30 Oct 2026 <span aria-hidden="true">·</span> Cuba / Remote</p>
        </div>

        <aside class="telemetry" aria-label="Verified public results">
          <div class="telemetry-head">
            <span>Public GitHub</span>
            <span>Verified 30 Oct 2026</span>
          </div>
          <ul class="telemetry-grid">
            <li class="telemetry-tile tile-blue">
              <span class="tile-label">Merged PRs</span>
              <strong>290</strong>
              <span class="tile-note">Lifetime public</span>
            </li>
            <li class="telemetry-tile tile-coral">
              <span class="tile-label">OCA merges</span>
              <strong>10</strong>
              <span class="tile-note">Across 8 repos</span>
            </li>
            <li class="telemetry-tile tile-green">
              <span class="tile-label">Reviews</span>
              <strong>78</strong>
              <span class="tile-note">34 repos · 28 authors</span>
            </li>
            <li class="telemetry-tile tile-yellow">
              <span class="tile-label">ODF tests</span>
              <strong>1,477</strong>
              <span class="tile-note">Unit tests</span>
            </li>
          </ul>
          <figure class="merge-card">
            <div class="merge-head">
              <span>290-tile merge matrix</span>
              <span>10 OCA</span>
            </div>
            <svg class="merge-wall" viewBox="0 0 290 100" role="img" aria-labelledby="wall-title wall-desc">
              <title id="wall-title">290 merged pull requests</title>
              <desc id="wall-desc">A wall of 290 tiles, one for every merged pull request. Ten tiles are highlighted in coral to represent the ten merged contributions to the Odoo Community Association.</desc>
              <defs>
                <pattern id="merge-tile" width="10" height="10" patternUnits="userSpaceOnUse">
                  <rect x="1" y="1" width="8" height="8" rx="1" fill="currentColor" opacity="0.3"></rect>
                </pattern>
              </defs>
              <rect width="290" height="100" fill="url(#merge-tile)"></rect>
              <g class="oca-tiles" aria-hidden="true">
                <rect x="21" y="11" width="8" height="8" rx="1"></rect>
                <rect x="51" y="21" width="8" height="8" rx="1"></rect>
                <rect x="81" y="11" width="8" height="8" rx="1"></rect>
                <rect x="111" y="31" width="8" height="8" rx="1"></rect>
                <rect x="141" y="21" width="8" height="8" rx="1"></rect>
                <rect x="171" y="41" width="8" height="8" rx="1"></rect>
                <rect x="201" y="11" width="8" height="8" rx="1"></rect>
                <rect x="231" y="31" width="8" height="8" rx="1"></rect>
                <rect x="261" y="21" width="8" height="8" rx="1"></rect>
                <rect x="281" y="41" width="8" height="8" rx="1"></rect>
              </g>
            </svg>
            <figcaption>290 merged pull requests. Every tile is one. Ten are in OCA.</figcaption>
            <p class="merge-meta">365 authored <span aria-hidden="true">·</span> 79% merge rate</p>
          </figure>
        </aside>
      </div>

      <div class="win-ticker" aria-hidden="true">
        <div class="ticker-track">
          <span>290 merged PRs</span><span>10 OCA merges</span><span>53 OCA reviews</span><span>1,477 unit tests</span><span>520× faster</span><span>8→19 Odoo</span><span>10 releases</span><span>9★ OWL</span>
          <span>290 merged PRs</span><span>10 OCA merges</span><span>53 OCA reviews</span><span>1,477 unit tests</span><span>520× faster</span><span>8→19 Odoo</span><span>10 releases</span><span>9★ OWL</span>
        </div>
      </div>
    </section>

    <section class="section focus-section" id="focus" aria-labelledby="focus-title">
      <div class="container">
        <header class="section-head">
          <p class="section-label">01 — Focus</p>
          <div class="section-title-row">
            <h2 id="focus-title">Four things I keep making better.</h2>
            <p class="section-intro">AI delivery, Odoo engineering, OWL frontends, and OCA collaboration. Each one has public receipts, not a slide deck.</p>
          </div>
        </header>

        <div class="focus-grid">
          <article class="focus-card focus-ai">
            <div class="focus-top">
              <span class="focus-index">01 // AI_TEAM</span>
              <span class="focus-icon" aria-hidden="true">✦</span>
            </div>
            <h3>AI Delivery</h3>
            <p class="focus-sub">ODF Agent Team</p>
            <p>Spec-driven Odoo delivery on OpenCode. Eleven specialist agents, fifty-one skills, and policy gates that make AI work reviewable instead of magical.</p>
            <ul class="focus-stats">
              <li><strong>11</strong> agents</li>
              <li><strong>51</strong> skills</li>
              <li><strong>1,477</strong> tests</li>
            </ul>
            <a class="focus-link" href="https://github.com/antoniodavid/odf-agent-team">Inspect repository <span aria-hidden="true">↗</span></a>
          </article>

          <article class="focus-card focus-odoo">
            <div class="focus-top">
              <span class="focus-index">02 // ERP_CORE</span>
              <span class="focus-icon" aria-hidden="true">⌘</span>
            </div>
            <h3>Odoo Engineering</h3>
            <p class="focus-sub">Modules and migrations, 8→19</p>
            <p>EasyPost, Plaid, POS, reporting, website, and localization changes. The kind of work that has to survive an OCA review and a real upgrade.</p>
            <ul class="focus-stats">
              <li><strong>8→19</strong> Odoo</li>
              <li><strong>10</strong> merged</li>
              <li><strong>37</strong> submitted</li>
            </ul>
            <a class="focus-link" href="#oca">Read the OCA ledger <span aria-hidden="true">↗</span></a>
          </article>

          <article class="focus-card focus-owl">
            <div class="focus-top">
              <span class="focus-index">03 // REACTIVE_UI</span>
              <span class="focus-icon" aria-hidden="true">◎</span>
            </div>
            <h3>OWL Frontend</h3>
            <p class="focus-sub">Hacking OWL</p>
            <p>A custom OWL web client and reusable components, built to understand the framework from the inside instead of treating it as a black box.</p>
            <ul class="focus-stats">
              <li><strong>9★</strong> GitHub</li>
              <li><strong>Apache-2.0</strong></li>
              <li><strong>OWL</strong></li>
            </ul>
            <a class="focus-link" href="https://github.com/antoniodavid/hacking-owl">Inspect repository <span aria-hidden="true">↗</span></a>
          </article>

          <article class="focus-card focus-oca">
            <div class="focus-top">
              <span class="focus-index">04 // OPEN_STANDARDS</span>
              <span class="focus-icon" aria-hidden="true">✓</span>
            </div>
            <h3>OCA Collaboration</h3>
            <p class="focus-sub">10 merged · 8 repositories</p>
            <p>37 pull requests submitted, 10 merged, and 53 reviews across 26 repositories and 22 authors. Teamwork, in public.</p>
            <ul class="focus-stats">
              <li><strong>10</strong> merged</li>
              <li><strong>8</strong> repos</li>
              <li><strong>53</strong> reviews</li>
            </ul>
            <a class="focus-link" href="#oca">See every merged change <span aria-hidden="true">↗</span></a>
          </article>
        </div>
      </div>
    </section>

    <section class="section proof-section" id="proof" aria-labelledby="proof-title">
      <div class="container">
        <header class="section-head">
          <p class="section-label">02 — Proof</p>
          <div class="section-title-row">
            <h2 id="proof-title">Hard numbers. No scavenger hunt.</h2>
            <p class="section-intro">Eight public numbers that explain the work before the first scroll. No private repositories, no inflated line counts, no borrowed stars.</p>
          </div>
        </header>

        <ul class="metrics-grid" aria-label="Verified wins">
          <li class="metric metric-blue">
            <span class="metric-index">01 / Merged</span>
            <strong>290</strong>
            <span class="metric-label">Merged pull requests</span>
            <p>Lifetime public PRs across client ERPs and open source.</p>
          </li>
          <li class="metric metric-coral">
            <span class="metric-index">02 / Merge rate</span>
            <strong>79%</strong>
            <span class="metric-label">Merge rate</span>
            <p>Merged-to-authored ratio from the public GitHub graph.</p>
          </li>
          <li class="metric metric-green">
            <span class="metric-index">03 / OCA</span>
            <strong>10</strong>
            <span class="metric-label">OCA merges</span>
            <p>Merged changes across 8 OCA repositories.</p>
          </li>
          <li class="metric metric-gold">
            <span class="metric-index">04 / Reviews</span>
            <strong>53</strong>
            <span class="metric-label">OCA reviews</span>
            <p>Across 26 repositories and 22 authors.</p>
          </li>
          <li class="metric metric-plum">
            <span class="metric-index">05 / Tests</span>
            <strong>1,477</strong>
            <span class="metric-label">ODF unit tests</span>
            <p>Plus 331 YAML tests and 18 harness tests.</p>
          </li>
          <li class="metric metric-blue">
            <span class="metric-index">06 / Speed</span>
            <strong>520×</strong>
            <span class="metric-label">OSEM speedup</span>
            <p>SQLite queries versus parsing the CLI.</p>
          </li>
          <li class="metric metric-coral">
            <span class="metric-index">07 / Versions</span>
            <strong>8→19</strong>
            <span class="metric-label">Odoo versions</span>
            <p>Modules and migrations from 8.0 to 19.0.</p>
          </li>
          <li class="metric metric-green">
            <span class="metric-index">08 / OWL</span>
            <strong>9★</strong>
            <span class="metric-label">Hacking OWL</span>
            <p>Stars on the OWL research repository.</p>
          </li>
        </ul>
      </div>
    </section>

    <section class="section work-section" id="work" aria-labelledby="work-title">
      <div class="container">
        <header class="section-head">
          <p class="section-label">03 — Selected work</p>
          <div class="section-title-row">
            <h2 id="work-title">Tools that remove the guesswork.</h2>
            <p class="section-intro">Six public projects across five languages. Each one started with a repeated annoyance and ended with something other people can use.</p>
          </div>
        </header>

        <article class="project-featured project-ai">
          <div class="project-featured-copy">
            <div class="project-topline">
              <p class="project-kind">Flagship <span aria-hidden="true">/</span> AI + TypeScript</p>
              <p class="project-badge">1,477 tests</p>
            </div>
            <h3>ODF Agent Team</h3>
            <p class="project-copy">Spec-driven Odoo delivery on OpenCode. Eleven specialist agents, fifty-one skills, policy gates, and 1,477 unit tests, so the work is found instead of invented.</p>
            <div class="pipeline" aria-label="ODF stage pipeline">
              <span>Decide</span><i aria-hidden="true">→</i><span>Plan</span><i aria-hidden="true">→</i><span>Build</span><i aria-hidden="true">→</i><span>Verify</span>
            </div>
            <dl class="project-stats">
              <div><dt>Unit tests</dt><dd>1,477</dd></div>
              <div><dt>Releases</dt><dd>10</dd></div>
              <div><dt>Stars / forks</dt><dd>14 / 7</dd></div>
            </dl>
            <a class="project-link" href="https://github.com/antoniodavid/odf-agent-team">View repository <span aria-hidden="true">↗</span></a>
          </div>

          <div class="terminal" aria-label="ODF proof summary">
            <div class="terminal-bar">
              <span class="terminal-dot" aria-hidden="true"></span>
              <span class="terminal-dot" aria-hidden="true"></span>
              <span class="terminal-dot" aria-hidden="true"></span>
              <span class="terminal-title">odf://proof-summary</span>
            </div>
            <pre class="terminal-body"><code>SPEC      route + context manifest
TESTS     1,477 unit · 331 yaml · 18 harness
RELEASES  10 tagged releases
REVIEW    policy gates + evidence
STATUS    mergeable

290 merged PRs · 79% merge rate</code></pre>
          </div>
        </article>

        <div class="project-grid">
          <article class="project project-odoo">
            <p class="project-kind">Odoo <span aria-hidden="true">/</span> Lua + Neovim</p>
            <h3>odoo.nvim</h3>
            <p class="project-copy">A zero-config Neovim IDE for Odoo 8.0 through 19.0. LSP stubs, Doodba support, and XML→Python navigation without a config weekend.</p>
            <dl class="project-stats">
              <div><dt>Odoo</dt><dd>8–19</dd></div>
              <div><dt>Commits</dt><dd>30</dd></div>
            </dl>
            <a class="project-link" href="https://github.com/antoniodavid/odoo.nvim">View repository <span aria-hidden="true">↗</span></a>
          </article>

          <article class="project project-ai">
            <p class="project-kind">AI <span aria-hidden="true">/</span> Go + Terminal</p>
            <h3>OSEM</h3>
            <p class="project-copy">A session manager for OpenCode. SQLite queries 520× faster than parsing the CLI, with fuzzy search, bookmarks, and tmux windows.</p>
            <dl class="project-stats">
              <div><dt>Faster</dt><dd>520×</dd></div>
              <div><dt>License</dt><dd>MIT</dd></div>
            </dl>
            <a class="project-link" href="https://github.com/antoniodavid/osem">View repository <span aria-hidden="true">↗</span></a>
          </article>

          <article class="project project-oca">
            <p class="project-kind">Connectivity <span aria-hidden="true">/</span> Go + Cuba</p>
            <h3>Conecta</h3>
            <p class="project-copy">One CLI for ETECSA portal login, WiFi hotspot sharing, WireGuard VPN, and speed tests, built for the realities of connectivity in Cuba.</p>
            <dl class="project-stats">
              <div><dt>Interfaces</dt><dd>TUI + CLI</dd></div>
              <div><dt>Commits</dt><dd>37</dd></div>
            </dl>
            <a class="project-link" href="https://github.com/antoniodavid/conecta">View repository <span aria-hidden="true">↗</span></a>
          </article>

          <article class="project project-owl">
            <p class="project-kind">AI <span aria-hidden="true">/</span> QML + Omarchy</p>
            <h3>Omarchy Agents</h3>
            <p class="project-copy">A bar panel that watches every AI subscription on the machine and turns usage records into limits, balances, and reset times.</p>
            <dl class="project-stats">
              <div><dt>Surface</dt><dd>QML panel</dd></div>
              <div><dt>Input</dt><dd>File watcher</dd></div>
            </dl>
            <a class="project-link" href="https://github.com/antoniodavid/omarchy-agents">View repository <span aria-hidden="true">↗</span></a>
          </article>

          <article class="project project-owl">
            <p class="project-kind">OWL <span aria-hidden="true">/</span> Python</p>
            <h3>Hacking OWL</h3>
            <p class="project-copy">Experiments with OWL, the Odoo web framework: a custom web client and reusable components for people who want to see how the pieces fit.</p>
            <dl class="project-stats">
              <div><dt>Stars</dt><dd>9</dd></div>
              <div><dt>License</dt><dd>Apache-2.0</dd></div>
            </dl>
            <a class="project-link" href="https://github.com/antoniodavid/hacking-owl">View repository <span aria-hidden="true">↗</span></a>
          </article>
        </div>

        <details class="more-projects">
          <summary>More experiments <span>5 repos</span></summary>
          <ul>
            <li><a href="https://github.com/antoniodavid/odoodevforge">OdooDevForge</a> — a proof of concept that generates an Odoo module from natural language.</li>
            <li><a href="https://github.com/antoniodavid/owl-app">OWL app</a> — a small to-do application built with OWL.</li>
            <li><a href="https://github.com/antoniodavid/simple">SIMple</a> — an Android app for ETECSA services, GPLv3 and Material You.</li>
            <li><a href="https://github.com/antoniodavid/saldoacuba">SaldoACuba</a> — a PHP service for Cuban mobile balances from 2018.</li>
            <li><a href="https://github.com/antoniodavid/omarchy-workspaces">Omarchy Workspaces</a> — a QML workspace switcher for the Omarchy desktop.</li>
          </ul>
        </details>
      </div>
    </section>

